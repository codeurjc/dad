{
  "realm": "dad",
  "enabled": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "inventario-lector", "description": "Puede consultar el stock del inventario" }
    ]
  },
  "clients": [
    {
      "clientId": "pedidos-service",
      "name": "Servicio de pedidos",
